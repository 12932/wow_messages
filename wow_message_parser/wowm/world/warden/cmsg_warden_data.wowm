cmsg CMSG_WARDEN_DATA = 0x2E7 {
    /* TODO ENCRYPTED_MESSAGES Handle encryption? */
    u8[-] encrypted_data;
} {
    versions = "1 2 3";
}

test CMSG_WARDEN_DATA {
    encrypted_data = [ 1, 2, 3, 4, 5 ];
} [
    0x00, 0x09, /* size */
    0xE7, 0x02, 0x00, 0x00, /* opcode */
    0x01, 0x02, 0x03, 0x04, 0x05, /* encrypted_data */
] {
    versions = "1.12";
}
