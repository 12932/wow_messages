    0x01, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[0] */
    0x02, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[1] */
    0x03, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[2] */
    0x04, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[3] */
    0x05, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[4] */
    0x06, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[5] */
    0x07, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[6] */
    0x08, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[7] */
    0x09, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[8] */
    0x0A, 0x00, 0x00, 0x00, 0x01, 0x00, /* questions[9] */
    0x00, /* answer_comment */
] {
    versions = "1.12";
}

cmsg CMSG_GMSURVEY_SUBMIT = 0x032A {
    /* Enum for survey id */
    u32 survey_id {
        comment = "cmangos: Survey ID: found in GMSurveySurveys.dbc";
    }
    GmSurveyQuestion[10] questions;
    CString answer_comment {
        comment = "cmangos: Answer comment: Unused in stock UI, can be only set by calling Lua function"; 
        comment = "cmangos: Answer comment max sizes in bytes: Vanilla - 8106:8110, TBC - 11459:11463, Wrath - 582:586";
    }
} {
    versions = "2 3";
}
