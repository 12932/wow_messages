smsg SMSG_SPELL_GO = 0x0132 {
    PackedGuid cast_item {
        comment = "cmangos/vmangos/mangoszero: if cast item is used, set this to guid of cast item, otherwise set it to same as caster.";
    }
    PackedGuid caster;
    Spell spell;
    CastFlags flags;

    u8 amount_of_hits;
    Guid[amount_of_hits] hits;

    u8 amount_of_misses;
    SpellMiss[amount_of_misses] misses;

    SpellCastTargets targets;
    if (flags & AMMO) {
        u32 ammo_display_id;
        u32 ammo_inventory_type;
    }
} {
    versions = "1.12";
}

test SMSG_SPELL_GO {
    cast_item = 4;
    caster = 4;
    spell = 75;
    flags = AMMO | UNKNOWN9;
    hits = [ ];
    misses = [
        {
            target = 0xF130000026000123;
            miss_info = MISS;
        },
    ];
    targets = {
        target_flags = UNIT;
        unit_target = 0xF130000026000123;
    };
    ammo_display_id = 5996;
    ammo_inventory_type = 24;
} [
    0x00, 0x27, /* size */
    0x32, 0x01, /* opcode */
    0x01, 0x04, /* cast_item */
    0x01, 0x04, /* caster */
    0x4B, 0x00, 0x00, 0x00, /* spell */
    0x20, 0x01, /* flags */
    0x00, /* amount_of_hits */
    0x01, /* amount_of_misses */
    /* misses: SpellMiss[amount_of_misses] start */
    /* misses: SpellMiss[amount_of_misses] 0 start */
        0x23, 0x01, 0x00, 0x26, 0x00, 0x00, 0x30, 0xF1, /* target */
        0x01, /* miss_info */
    /* misses: SpellMiss[amount_of_misses] 0 end */
    /* misses: SpellMiss[amount_of_misses] end */
    /* targets: SpellCastTargets start */
        0x02, 0x00, /* target_flags */
        0xCB, 0x23, 0x01, 0x26, 0x30, 0xF1, /* unit_target */
    /* targets: SpellCastTargets end */
    0x6C, 0x17, 0x00, 0x00, /* ammo_display_id */
    0x18, 0x00, 0x00, 0x00, /* ammo_inventory_type */
] {
    versions = "1.12";
}

test SMSG_SPELL_GO {
    cast_item = 0xF13000024D000456;
    caster = 0xF13000024D000456;
    spell = 116;
    flags = UNKNOWN9;
    hits = [ ];
    misses = [
        {
            target = 4;
            miss_info = REFLECT;
            reflect_result = NONE;
        },
    ];
    targets = {
        target_flags = UNIT;
        unit_target = 4;
    };
} [
    0x00, 0x26, /* size */
    0x32, 0x01, /* opcode */
    0xDB, 0x56, 0x04, 0x4D, 0x02, 0x30, 0xF1, /* cast_item */
    0xDB, 0x56, 0x04, 0x4D, 0x02, 0x30, 0xF1, /* caster */
    0x74, 0x00, 0x00, 0x00, /* spell */
    0x00, 0x01, /* flags */
    0x00, /* amount_of_hits */
    0x01, /* amount_of_misses */
    /* misses: SpellMiss[amount_of_misses] start */
    /* misses: SpellMiss[amount_of_misses] 0 start */
        0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, /* target */
        0x0B, /* miss_info */
        0x00, /* reflect_result */
    /* misses: SpellMiss[amount_of_misses] 0 end */
    /* misses: SpellMiss[amount_of_misses] end */
    /* targets: SpellCastTargets start */
        0x02, 0x00, /* target_flags */
        0x01, 0x04, /* unit_target */
    /* targets: SpellCastTargets end */
] {
    versions = "1.12";
}

smsg SMSG_SPELL_GO = 0x0132 {
    PackedGuid cast_item {
        comment = "cmangos/vmangos/mangoszero: if cast item is used, set this to guid of cast item, otherwise set it to same as caster.";
    }
    PackedGuid caster;
    Spell spell;
    CastFlags flags;

    u32 timestamp;

    u8 amount_of_hits;
    Guid[amount_of_hits] hits;

    u8 amount_of_misses;
    SpellMiss[amount_of_misses] misses;

    SpellCastTargets targets;
    if (flags & AMMO) {
        u32 ammo_display_id;
        u32 ammo_inventory_type;
    }
} {
    versions = "2.4.3";
}

smsg SMSG_SPELL_GO = 0x0132 {
    PackedGuid cast_item {
        comment = "cmangos/vmangos/mangoszero: if cast item is used, set this to guid of cast item, otherwise set it to same as caster.";
    }
    PackedGuid caster;
    u8 extra_casts;
    Spell spell;
    GameobjectCastFlags flags;

    u32 timestamp;
    SpellCastTargets targets;

    if(flags & POWER_UPDATE) {
        (u32)Power power;
    }
    if (flags & RUNE_UPDATE) {
        u8 rune_mask_initial;
        u8 rune_mask_after_cast;
        u8[6] rune_cooldowns;
    }
    if (flags & ADJUST_MISSILE) {
        f32 elevation;
        u32 delay_trajectory;
    }
    if (flags & AMMO) {
        u32 ammo_display_id;
        u32 ammo_inventory_type;
    }
    if (flags & VISUAL_CHAIN) {
        u32 unknown1;
        u32 unknown2;
    }
    if (flags & DEST_LOCATION) {
        u8 unknown3;
    }
} {
    versions = "3.3.5";
}
