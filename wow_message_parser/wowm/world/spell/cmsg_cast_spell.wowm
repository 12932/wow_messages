cmsg CMSG_CAST_SPELL = 0x012E {
    Spell spell;
    SpellCastTargets targets;
} {
    paste_versions = "1.12 2.4.3";
}

cmsg CMSG_CAST_SPELL = 0x012E {
    u8 cast_count;
    Spell spell;
    ClientCastFlags cast_flags;
    SpellCastTargets targets;
    if (cast_flags == EXTRA) {
        f32 elevation;
        f32 speed;
        ClientMovementData movement_data;
        if (movement_data == PRESENT) {
            u32 opcode;
            PackedGuid guid;
            MovementInfo info;
        }
    }
} {
    versions = "3.3.5";
}

test CMSG_CAST_SPELL {
    spell = 20600;
    targets = {
        target_flags = SELF;
    };
} [
    0x00, 0x0A, /* size */
    0x2E, 0x01, 0x00, 0x00, /* opcode */
    0x78, 0x50, 0x00, 0x00, /* spell */
    /* targets: SpellCastTargets start */
        0x00, 0x00, /* target_flags */
    /* targets: SpellCastTargets end */
] {
    versions = "1.12";
}


/* An enemy corpse with a destination (0x0240): the client writes the corpse's guid before the location. */
test CMSG_CAST_SPELL {
    spell = 20600;
    targets = {
        target_flags = PVP_CORPSE | DEST_LOCATION;
        pvp_corpse = 0xF10000000000002A;
        destination = {
            x = 1.0;
            y = 2.0;
            z = 3.0;
        };
    };
} [
    0x00, 0x19, /* size */
    0x2E, 0x01, 0x00, 0x00, /* opcode */
    0x78, 0x50, 0x00, 0x00, /* spell */
    /* targets: SpellCastTargets start */
        0x40, 0x02, /* target_flags */
        0x81, 0x2A, 0xF1, /* pvp_corpse */
        /* destination: Vector3d start */
            0x00, 0x00, 0x80, 0x3F, /* x */
            0x00, 0x00, 0x00, 0x40, /* y */
            0x00, 0x00, 0x40, 0x40, /* z */
        /* destination: Vector3d end */
    /* targets: SpellCastTargets end */
] {
    versions = "1.12";
}

/* An ally's corpse with a destination (0x8040). */
test CMSG_CAST_SPELL {
    spell = 20600;
    targets = {
        target_flags = CORPSE | DEST_LOCATION;
        corpse = 0xF10000000000002A;
        destination = {
            x = 1.0;
            y = 2.0;
            z = 3.0;
        };
    };
} [
    0x00, 0x19, /* size */
    0x2E, 0x01, 0x00, 0x00, /* opcode */
    0x78, 0x50, 0x00, 0x00, /* spell */
    /* targets: SpellCastTargets start */
        0x40, 0x80, /* target_flags */
        0x81, 0x2A, 0xF1, /* corpse */
        /* destination: Vector3d start */
            0x00, 0x00, 0x80, 0x3F, /* x */
            0x00, 0x00, 0x00, 0x40, /* y */
            0x00, 0x00, 0x40, 0x40, /* z */
        /* destination: Vector3d end */
    /* targets: SpellCastTargets end */
] {
    versions = "1.12";
}

/* A unit and an item (0x0012): one guid for each. */
test CMSG_CAST_SPELL {
    spell = 20600;
    targets = {
        target_flags = UNIT | ITEM;
        unit_target = 0xF130000026000123;
        item = 0x4000000000000007;
    };
} [
    0x00, 0x13, /* size */
    0x2E, 0x01, 0x00, 0x00, /* opcode */
    0x78, 0x50, 0x00, 0x00, /* spell */
    /* targets: SpellCastTargets start */
        0x12, 0x00, /* target_flags */
        0xCB, 0x23, 0x01, 0x26, 0x30, 0xF1, /* unit_target */
        0x81, 0x07, 0x40, /* item */
    /* targets: SpellCastTargets end */
] {
    versions = "1.12";
}

/* A unit with OBJECT_UNK and UNK1 set too (0x4082): still one guid, the client's. */
test CMSG_CAST_SPELL {
    spell = 20600;
    targets = {
        target_flags = UNIT | OBJECT_UNK | UNK1;
        unit_target = 0xF130000026000123;
    };
} [
    0x00, 0x10, /* size */
    0x2E, 0x01, 0x00, 0x00, /* opcode */
    0x78, 0x50, 0x00, 0x00, /* spell */
    /* targets: SpellCastTargets start */
        0x82, 0x40, /* target_flags */
        0xCB, 0x23, 0x01, 0x26, 0x30, 0xF1, /* unit_target */
    /* targets: SpellCastTargets end */
] {
    versions = "1.12";
}
