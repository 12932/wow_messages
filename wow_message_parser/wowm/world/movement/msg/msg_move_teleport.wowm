smsg MSG_MOVE_TELEPORT_Server = 0x00C5 {
    PackedGuid player;
    MovementInfo info;
} {
    versions = "1.12";
    comment = "Sent to those who see a unit teleport (mangos-classic's Unit::SendTeleportPacket).";
}

